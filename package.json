{
  "name": "smart-wardrobe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @wardrobe/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:stack": "tsx tests/stack.ts",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "tsx": "4.23.15",
    "@types/node": "26.6.6",
    "yaml": "2.9.1"
  }
}
