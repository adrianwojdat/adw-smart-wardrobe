{
  "name": "smart-wardrobe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @wardrobe/web dev",
    "prepare": "husky",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/lint-baseline.mjs",
    "lint:raw": "eslint .",
    "lint:baseline:write": "node scripts/lint-baseline.mjs --write-baseline",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write .",
    "format:check": "node scripts/format-baseline.mjs",
    "format:raw": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check .",
    "format:baseline:write": "node scripts/format-baseline.mjs --write-baseline",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:stack": "tsx tests/stack.ts",
    "deps:check": "depcruise --config .dependency-cruiser.mjs --ignore-known .dependency-cruiser-known-violations.json apps packages",
    "deps:baseline:write": "depcruise --config .dependency-cruiser.mjs --baseline .dependency-cruiser-known-violations.json apps packages",
    "knip:check": "node scripts/knip-baseline.mjs",
    "knip:baseline:write": "node scripts/knip-baseline.mjs --write-baseline",
    "setup": "node scripts/setup.mjs",
    "check": "pnpm style:check && pnpm language:check && pnpm lint && pnpm typecheck && pnpm test && pnpm deps:check && pnpm check:layout && pnpm check:i18n && pnpm knip:check && pnpm build",
    "check:layout": "node scripts/check-src-layout.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "style:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check . && eslint --config eslint.style.config.js . --max-warnings 0",
    "style:fix": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write . && eslint --config eslint.style.config.js . --fix && prettier --ignore-path .gitignore --ignore-path .prettierignore --write . && pnpm style:check",
    "language:check": "node scripts/language-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{css,html,json,md,yaml,yml}": "prettier --check",
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "node scripts/lint-baseline.mjs --staged",
      "prettier --check"
    ]
  }
}
