# Generate .env safely with: node scripts/setup.mjs
APP_ORIGIN=http://localhost:8080
# Optional comma-separated exact origins for LAN access, e.g. http://192.168.0.217:8080
APP_ADDITIONAL_ORIGINS=
HTTP_PORT=8080
# Image directory on the Docker host (inside LXC when Docker runs in LXC). Must support xattrs.
STORAGE_PATH=./data/storage
HTTPS_PORT=8443
# Set your domain here for Caddy automatic HTTPS; APP_ORIGIN must match.
SITE_ADDRESS=:80
COOKIE_SECURE=false
SITE_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=http://localhost:8080/reset-password
SUPABASE_PUBLIC_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8080/api/auth
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_DB_PASSWORD=
WORKER_DB_PASSWORD=
SESSION_ENCRYPTION_KEY=
# Comma-separated Supabase Auth user UUIDs allowed to view /api/admin/queues.
# Empty disables the panel. Users must still log in through Smart Wardrobe.
QUEUE_ADMIN_USER_IDS=
REDIS_PASSWORD=
DASHBOARD_USERNAME=wardrobe-admin
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
STUDIO_DEFAULT_ORGANIZATION=Smart Wardrobe
STUDIO_DEFAULT_PROJECT=Smart Wardrobe
OPENAI_API_KEY=
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
POOLER_TENANT_ID=smart-wardrobe
POOLER_DEFAULT_POOL_SIZE=10
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Local installation: registration without email verification. Set false with real SMTP.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=wardrobe@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Smart Wardrobe
MAILER_URLPATHS_CONFIRMATION=/api/auth/verify
MAILER_URLPATHS_INVITE=/api/auth/verify
MAILER_URLPATHS_RECOVERY=/api/auth/verify
MAILER_URLPATHS_EMAIL_CHANGE=/api/auth/verify
GLOBAL_S3_BUCKET=wardrobe
REGION=local
STORAGE_TENANT_ID=smart-wardrobe
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=1g
OLLAMA_BASE_URL=
OLLAMA_VISION_MODEL=

# Gemini credentials are encrypted in PostgreSQL with this server-only key.
GEMINI_ENCRYPTION_KEY=
# Shared Gemini API controls; the upstream quotas are project/model-specific.
GEMINI_RPM_LIMIT=12
GEMINI_MAX_QUEUE=100
GEMINI_TASK_TIMEOUT_MS=900000
# Set one common identifier for users whose API keys belong to the same Google project.
# Stored as an HMAC-derived Redis key; never put API keys here.
GEMINI_SHARED_QUOTA_ID=
# Reserved for later token/day accounting; not currently enforced by connection tests.
GEMINI_TPM_LIMIT=
GEMINI_RPD_LIMIT=

# Optional LOCAL DEVELOPMENT mail relay. Leave disabled in production.
# Enable with COMPOSE_PROFILES=dev-mail and SMTP_HOST=dev-mail-relay, SMTP_PORT=1025.
# GoTrue SMTP_USER/SMTP_PASS stay empty; upstream credentials are local .env only.
DEV_SMTP_HOST=host.docker.internal
DEV_SMTP_PORT=1025
DEV_SMTP_USER=
DEV_SMTP_PASS=

# CPU garment classification; Ollama remains optional for label OCR.
GARMENT_ANALYSIS_PROVIDER=fashion-siglip
