# Generate .env safely with: node scripts/setup.mjs
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443
# Set your domain here for Caddy automatic HTTPS; APP_ORIGIN must match.
SITE_ADDRESS=:80
COOKIE_SECURE=false
SITE_URL=http://localhost:8080
ADDITIONAL_REDIRECT_URLS=http://localhost:8080/reset-password
SUPABASE_PUBLIC_URL=http://localhost:8080
API_EXTERNAL_URL=http://localhost:8080/api/auth
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SESSION_DB_PASSWORD=
WORKER_DB_PASSWORD=
SESSION_ENCRYPTION_KEY=
REDIS_PASSWORD=
DASHBOARD_USERNAME=wardrobe-admin
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
STUDIO_DEFAULT_ORGANIZATION=Smart Wardrobe
STUDIO_DEFAULT_PROJECT=Smart Wardrobe
OPENAI_API_KEY=
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
POOLER_TENANT_ID=smart-wardrobe
POOLER_DEFAULT_POOL_SIZE=10
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Local installation: registration without email verification. Set false with real SMTP.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=wardrobe@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Smart Wardrobe
MAILER_URLPATHS_CONFIRMATION=/api/auth/verify
MAILER_URLPATHS_INVITE=/api/auth/verify
MAILER_URLPATHS_RECOVERY=/api/auth/verify
MAILER_URLPATHS_EMAIL_CHANGE=/api/auth/verify
GLOBAL_S3_BUCKET=wardrobe
REGION=local
STORAGE_TENANT_ID=smart-wardrobe
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=true
FUNCTIONS_MEMORY_LIMIT=1g
OLLAMA_BASE_URL=
OLLAMA_MODEL=
